{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.aws/*": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "rm -rf *": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  }
}
