{
  "toolPermission": "request-review",
  "artifactReviewPolicy": "asks-for-review",
  "allowNonWorkspaceAccess": "off",
  "permissions": {
    "deny": [
      "command(rm -rf)",
      "command(sudo)",
      "command(git reset --hard)",
      "command(git clean -fd)",
      "command(git push --force)",
      "write_file(.git/)",
      "read_file(~/.ssh)",
      "read_file(~/.gnupg)",
      "read_file(~/.aws)"
    ]
  }
}
