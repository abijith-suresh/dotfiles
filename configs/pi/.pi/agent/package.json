{
  "name": "dotfiles-pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Pi coding agent setup managed by dotfiles",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit && npm --prefix extensions/subagents run check",
    "format": "prettier --write \"extensions/**/*.ts\" \"*.json\" \"extensions/**/*.json\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"*.json\" \"extensions/**/*.json\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "effect": "^4.0.0-beta.99",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prettier": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
