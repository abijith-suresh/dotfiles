{
  "name": "dotfiles-pi-setup",
  "version": "1.0.0",
  "private": true,
  "description": "Pi coding agent setup managed by dotfiles",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"tests/**/*.ts\" \"*.json\"",
    "test": "node --experimental-test-module-mocks --test tests/*.test.ts"
  },
  "dependencies": {
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
