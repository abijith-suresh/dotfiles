{
  "name": "dotfiles-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "check:pi": "tsc -p tests/pi/tsconfig.json",
    "test:pi": "node --experimental-test-module-mocks --test tests/pi/*.test.ts",
    "format:pi": "prettier --write \"configs/pi/.pi/agent/**/*.ts\" \"tests/pi/**/*.ts\"",
    "format:check": "prettier --check \"configs/pi/.pi/agent/**/*.ts\" \"tests/pi/**/*.ts\""
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "24.19.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
